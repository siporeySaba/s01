rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /episodes/{episodeId} {
      allow read: if true;

      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ניוזלטר: כל אחד יכול להירשם, אף אחד לא יכול לקרוא את הרשימה מהאתר
    match /subscribers/{token} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'consent', 'createdAt'])
        && request.resource.data.email is string
        && request.resource.data.email.size() < 200
        && request.resource.data.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() < 100))
        && request.resource.data.consent == true
        && token.size() >= 20;
      allow read, update, delete: if false;
    }

    // בקשות הסרה: נוצרות מהקישור במייל ומעובדות בשליחה הבאה
    match /unsubscribes/{token} {
      allow create: if request.resource.data.keys().hasOnly(['at']) && token.size() >= 20;
      allow read, update, delete: if false;
    }
  }
}
